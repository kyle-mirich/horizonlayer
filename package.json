{
  "name": "horizonlayer",
  "version": "0.0.1",
  "description": "Local-first MCP server for durable agent knowledge backed by PostgreSQL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyle-mirich/horizonlayer.git"
  },
  "homepage": "https://github.com/kyle-mirich/horizonlayer#readme",
  "bugs": {
    "url": "https://github.com/kyle-mirich/horizonlayer/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "agent-memory",
    "knowledge-base",
    "search"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "horizonlayer": "dist/launcher.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/testing",
    "schema.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:reset": "docker compose down -v",
    "demo:agent": "tsx src/testing/agentDemo.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke:live": "tsx src/testing/liveSmoke.ts",
    "test:smoke:local": "bash scripts/smoke-local.sh",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "start": "node dist/launcher.js",
    "dev": "tsx src/launcher.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.22.0",
    "xsschema": "^0.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
