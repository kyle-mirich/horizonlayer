{
  "name": "horizonlayer",
  "version": "0.1.1",
  "description": "Local-first MCP server for durable agent knowledge and issue tracking backed by PostgreSQL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyle-mirich/horizonlayer.git"
  },
  "homepage": "https://github.com/kyle-mirich/horizonlayer#readme",
  "bugs": {
    "url": "https://github.com/kyle-mirich/horizonlayer/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "agent-memory",
    "knowledge-base",
    "issue-tracking",
    "search"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "horizonlayer": "dist/launcher.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/testing",
    "docker-compose.yml",
    ".claude-plugin/marketplace.json",
    "plugins/horizonlayer",
    "schema.sql",
    "README.md",
    "docs",
    "!docs/assets",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:server && npm run build:dashboard",
    "build:server": "tsc",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "demo:agent": "tsx src/testing/agentDemo.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:coverage": "vitest run --coverage --exclude \"**/*.integration.test.ts\"",
    "test:integration:postgres": "node -e \"if (!process.env.HORIZONLAYER_INTEGRATION_DATABASE_URL) throw new Error('HORIZONLAYER_INTEGRATION_DATABASE_URL is required')\" && vitest run --no-file-parallelism src/db/concurrency.integration.test.ts src/db/issueModel.integration.test.ts src/db/searchGeneration.integration.test.ts src/search/rag.integration.test.ts",
    "test:smoke:dashboard": "tsx src/testing/dashboardLiveSmoke.ts",
    "test:smoke:live": "tsx src/testing/liveSmoke.ts",
    "test:smoke:local": "bash scripts/smoke-local.sh",
    "test:smoke:recovery": "bash scripts/smoke-recovery.sh",
    "typecheck": "npm run typecheck:server && npm run typecheck:dashboard",
    "typecheck:server": "tsc --noEmit",
    "typecheck:dashboard": "tsc -p dashboard/tsconfig.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "start": "node dist/launcher.js",
    "start:dashboard": "node dist/launcher.js dashboard",
    "dev": "tsx src/launcher.ts",
    "dev:dashboard": "tsx src/launcher.ts dashboard",
    "dev:dashboard:ui": "vite --config dashboard/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qdrant/js-client-rest": "1.18.0",
    "pg": "^8.22.0",
    "xsschema": "^0.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/recursive": "^5.2.8",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
